{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Read-only access to the projects root, with file watching.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$HOME/.driver" }, { "path": "$HOME/.driver/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/.driver/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/.driver" }]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [{ "path": "$HOME/.driver" }, { "path": "$HOME/.driver/**" }]
    },
    "fs:allow-unwatch"
  ]
}
